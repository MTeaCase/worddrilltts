<?xml version="1.0" encoding="utf-8"?>
<!--
    这个文件是 TTS 引擎的「自我介绍」，通过 AndroidManifest 里的
    <meta-data android:name="android.speech.tts" android:resource="@xml/tts_engine"/>
    被系统的「文字转语音」设置页读取，用来在不启动引擎的情况下知道它会哪些语言。

    两个坑（都踩过）：
    1. 只有 android:settingsActivity 是框架定义的属性，其它写着 android: 前缀的
       （displayName / displayCountry / country / variant）AAPT 会直接报错；
    2. <lang> 的这些属性是运行期按「无命名空间」读的，所以不能加 android: 前缀。

    真正的语言能力仍以 TtsEngineService.onGetVoices / onIsLanguageAvailable 为准，
    这里只是给系统设置页显示用。
-->
<tts-engine xmlns:android="http://schemas.android.com/apk/res/android">
    <languages>
        <lang name="eng" country="USA" variant="" />
        <lang name="eng" country="GBR" variant="" />
    </languages>
</tts-engine>